{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Competition evidence v1 - independent of the unchanged core safety loop",
  "Resources": {
    "EvidenceApiv1Stage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 2,
          "ThrottlingRateLimit": 1
        },
        "ApiId": {
          "Ref": "EvidenceApi"
        },
        "StageName": "v1",
        "Tags": {
          "httpapi:createdBy": "SAM"
        },
        "AutoDeploy": true
      }
    },
    "EvidenceBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "expire-evidence",
              "Status": "Enabled",
              "ExpirationInDays": 30
            }
          ]
        }
      }
    },
    "EvidenceApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Body": {
          "info": {
            "version": "1.0",
            "title": {
              "Ref": "AWS::StackName"
            }
          },
          "paths": {
            "/evidence": {
              "post": {
                "x-amazon-apigateway-integration": {
                  "httpMethod": "POST",
                  "type": "aws_proxy",
                  "uri": {
                    "Fn::Sub": "arn:${AWS::Partition}:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${EvidenceFunction.Arn}/invocations"
                  },
                  "payloadFormatVersion": "2.0"
                },
                "security": [
                  {
                    "AWS_IAM": []
                  }
                ],
                "responses": {}
              }
            }
          },
          "openapi": "3.0.1",
          "components": {
            "securitySchemes": {
              "AWS_IAM": {
                "type": "apiKey",
                "name": "Authorization",
                "in": "header",
                "x-amazon-apigateway-authtype": "awsSigv4"
              }
            }
          },
          "tags": [
            {
              "name": "httpapi:createdBy",
              "x-amazon-apigateway-tag-value": "SAM"
            }
          ]
        }
      }
    },
    "EvidenceFunctionEvidencePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "EvidenceFunction"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": [
            "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${__ApiId__}/${__Stage__}/POST/evidence",
            {
              "__ApiId__": {
                "Ref": "EvidenceApi"
              },
              "__Stage__": "*"
            }
          ]
        }
      }
    },
    "EvidenceLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-evidence"
        },
        "RetentionInDays": 14
      }
    },
    "TraceTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "TraceId",
            "AttributeType": "S"
          },
          {
            "AttributeName": "Sequence",
            "AttributeType": "N"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "TraceId",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "Sequence",
            "KeyType": "RANGE"
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "ExpiresAt",
          "Enabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "SSESpecification": {
          "SSEEnabled": true
        }
      }
    },
    "EvidenceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "evidence-only",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${EvidenceBucket.Arn}/evidence/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:PutItem",
                    "dynamodb:GetItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "TraceTable",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-evidence:*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "EvidenceFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "EvidenceLogGroup",
      "Properties": {
        "Code": {
          "S3Bucket": "REPLACE_WITH_APPROVED_AEGISLAND_ARTIFACT_BUCKET",
          "S3Key": "REPLACE_WITH_REVIEWED_ARTIFACT_KEY"
        },
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-evidence"
        },
        "Handler": "app.handler",
        "MemorySize": 256,
        "Role": {
          "Fn::GetAtt": [
            "EvidenceRole",
            "Arn"
          ]
        },
        "Runtime": "python3.12",
        "Timeout": 25,
        "Environment": {
          "Variables": {
            "TRACE_TABLE": {
              "Ref": "TraceTable"
            },
            "EVIDENCE_BUCKET": {
              "Ref": "EvidenceBucket"
            }
          }
        },
        "Tags": [
          {
            "Key": "lambda:createdBy",
            "Value": "SAM"
          }
        ],
        "Architectures": [
          "arm64"
        ]
      }
    },
    "EvidenceBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "EvidenceBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "EvidenceBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${EvidenceBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "${EvidenceBucket.Arn}/evidence/*"
              },
              "Condition": {
                "Null": {
                  "s3:if-none-match": "true"
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "EvidenceEndpoint": {
      "Value": {
        "Fn::Sub": "https://${EvidenceApi}.execute-api.${AWS::Region}.${AWS::URLSuffix}/v1"
      }
    },
    "EvidenceBucketName": {
      "Value": {
        "Ref": "EvidenceBucket"
      }
    },
    "TraceTableName": {
      "Value": {
        "Ref": "TraceTable"
      }
    }
  }
}
